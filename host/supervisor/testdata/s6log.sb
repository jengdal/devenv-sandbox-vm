(version 1)
(deny default)
(allow process-exec (literal "/nix/store/aaa-one/bin/s6-log"))
(allow file-read* (literal "/nix/store/aaa-one/bin/s6-log"))
(allow signal (target self))
(allow process-info* (target self))
(allow sysctl-read)
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/Library/Apple")
  (literal "/")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-map-executable
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/usr/lib"))
(allow file-read* file-write-data
  (literal "/dev/null")
  (literal "/dev/zero"))
(allow file-read-metadata
  (literal "/etc")
  (literal "/tmp")
  (literal "/var"))
(allow file-read*
  (literal "/private/etc/localtime")
  (subpath "/private/var/db/timezone"))
(allow file-read* file-map-executable (subpath "/nix/store/aaa-one"))
(allow file-read* file-map-executable (subpath "/nix/store/bbb-two"))
(allow file-read* file-write* (subpath "/Users/tester/.devenv-sandbox-vm/vm1/log/console"))
(allow file-read-metadata
  (literal "/Users")
  (literal "/Users/tester")
  (literal "/Users/tester/.devenv-sandbox-vm")
  (literal "/Users/tester/.devenv-sandbox-vm/vm1")
  (literal "/Users/tester/.devenv-sandbox-vm/vm1/log")
  (literal "/nix")
  (literal "/nix/store")
  (literal "/nix/store/aaa-one")
  (literal "/nix/store/aaa-one/bin"))
