(version 1)
(deny default)
(allow process-exec (literal "/nix/store/aaa-one/bin/gvproxy"))
(allow file-read* (literal "/nix/store/aaa-one/bin/gvproxy"))
(allow signal (target self))
(allow process-info* (target self))
(allow sysctl-read)
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/Library/Apple")
  (literal "/")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-map-executable
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/usr/lib"))
(allow file-read* file-write-data
  (literal "/dev/null")
  (literal "/dev/zero"))
(allow file-read-metadata
  (literal "/etc")
  (literal "/tmp")
  (literal "/var"))
(allow file-read*
  (literal "/private/etc/localtime")
  (subpath "/private/var/db/timezone"))
(allow file-read* file-map-executable (subpath "/nix/store/aaa-one"))
(allow file-read* file-map-executable (subpath "/nix/store/bbb-two"))
(allow file-read-metadata file-write-create (literal "/Users/tester/.devenv-sandbox-vm/vm1/net.sock"))
(allow network-bind network-inbound (local unix-socket (literal "/Users/tester/.devenv-sandbox-vm/vm1/net.sock")))
(allow network-outbound (remote unix-socket (subpath "/private/tmp/svm-1")))
(allow file-read-metadata
  (literal "/Users")
  (literal "/Users/tester")
  (literal "/Users/tester/.devenv-sandbox-vm")
  (literal "/Users/tester/.devenv-sandbox-vm/vm1")
  (literal "/nix")
  (literal "/nix/store")
  (literal "/nix/store/aaa-one")
  (literal "/nix/store/aaa-one/bin")
  (literal "/private")
  (literal "/private/tmp"))
(allow network-bind network-inbound (local tcp "localhost:22000"))
(allow network-outbound (remote tcp "localhost:23000"))
