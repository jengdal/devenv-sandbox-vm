(version 1)
(deny default)
(allow process-exec (literal "/nix/store/aaa-one/bin/smokescreen"))
(allow file-read* (literal "/nix/store/aaa-one/bin/smokescreen"))
(allow signal (target self))
(allow process-info* (target self))
(allow sysctl-read)
(allow file-read*
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/Library/Apple")
  (literal "/")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-map-executable
  (subpath "/System/Library/Frameworks")
  (subpath "/System/Library/PrivateFrameworks")
  (subpath "/usr/lib"))
(allow file-read* file-write-data
  (literal "/dev/null")
  (literal "/dev/zero"))
(allow file-read-metadata
  (literal "/etc")
  (literal "/tmp")
  (literal "/var"))
(allow file-read*
  (literal "/private/etc/localtime")
  (subpath "/private/var/db/timezone"))
(allow file-read* file-map-executable (subpath "/nix/store/aaa-one"))
(allow file-read* file-map-executable (subpath "/nix/store/bbb-two"))
(allow file-read-metadata
  (literal "/nix")
  (literal "/nix/store")
  (literal "/nix/store/aaa-one")
  (literal "/nix/store/aaa-one/bin"))
(allow network-bind network-inbound (local tcp "localhost:23000"))
(allow network-outbound (remote tcp "*:*"))
(deny network-outbound (remote ip "localhost:*"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
