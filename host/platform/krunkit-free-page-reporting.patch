+/// The KRUN_FREE_PAGE_REPORTING_MODE_* value for a --free-page-reporting argument.
+pub fn parse_free_page_reporting(s: &str) -> Result<u32, String> {
+    match s {
+        "default" => Ok(0),
+        "replace" => Ok(1),
+        _ => Err("expected 'default' or 'replace'".to_string()),
+    }
 }
 
